# Environment Configuration
# Copy this file to .env.development and fill in your values

# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (Neon DB Integration)
# Option A: Paste your Neon DB connection string URL directly:
# DATABASE_URL=postgresql://user:password@ep-cool-darkness-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: Individual fields:
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=lorry_erp
DATABASE_USER=erp_user
DATABASE_PASSWORD=erp_password
DATABASE_SSL=false
DATABASE_SYNC=false
DATABASE_LOGGING=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=dev-jwt-secret-change-in-prod
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-in-prod
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MinIO / S3 Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=lorry-erp

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# GPS Provider Adapter (none | traccar | wialon)
GPS_PROVIDER=none
